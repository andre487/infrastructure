# Config is autogenerated – do not change it manually
server {
    listen 80;
    listen [::]:80;

    server_name {{ http_domain }};

    include /etc/nginx/server.d/{{ http_domain }}/*.conf;

    location / {
        include /etc/nginx/location.d/{{ http_domain }}/root/*.conf;

        root /var/www/{{ http_domain }};
    }
}
